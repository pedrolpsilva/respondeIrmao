{
  "expo": {
    "name": "Responde, Irmão",
    "slug": "respondeIrmao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "respondeirmao",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEFCE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.totaltrac.respondeIrmao"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFCE8",
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa de acesso às suas fotos para você escolher a imagem do jogador.",
          "cameraPermission": "O aplicativo precisa de acesso à câmera para você tirar a foto do jogador."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo precisa de acesso à câmera para você tirar a foto do jogador."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3347922540508260~7095372447",
    "ios_app_id": "ca-app-pub-3347922540508260~7095372447"
  }
}
